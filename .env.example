# Copy to .env (git-ignored) and fill in. Values already set in the environment win.

# Groq API key from https://console.groq.com/keys. With it set, the backend is Groq;
# without it, CacheGuard falls back to the 20 Newsgroups search backend.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# CACHEGUARD_GROQ_MODEL=openai/gpt-oss-20b
# CACHEGUARD_GROQ_REASONING_EFFORT=low
# CACHEGUARD_SYSTEM_PROMPT=You are a concise, accurate assistant. Answer in at most a few short paragraphs.
# CACHEGUARD_MAX_TOKENS=512
# CACHEGUARD_PRICE_INPUT_PER_M=0.075
# CACHEGUARD_PRICE_OUTPUT_PER_M=0.30

# Public demo protection
# CACHEGUARD_RATE_LIMIT_PER_MINUTE=30
# CACHEGUARD_DAILY_BACKEND_CALLS=500
# CACHEGUARD_TRUST_PROXY=off
# CACHEGUARD_ADMIN_TOKEN=
